# ================= PINTEREST CONFIG =================
# Pinterest session cookie (_pinterest_sess value from browser cookies)
PINTEREST_SESSION=
# Target Pinterest Board ID (Optional - if blank, bot auto-picks or creates your board)
PINTEREST_BOARD_ID=
# Pinterest account username
PINTEREST_USERNAME=
# Interval between posting pins in minutes (safe recommended: 35)
POST_INTERVAL_MINUTES=35

# ================= WEB APP & MONETAG CONFIG =================
# Your live Render URL (e.g. https://pintrest-automation.onrender.com)
SITE_BASE_URL=https://pintrest-automation.onrender.com
# Monetag direct high-RPM link (triggers on button clicks)
MONETAG_DIRECT_LINK=https://uplcm.com/4/12271752
# Monetag official in-page push / vignette script tag (add when domain is approved)
MONETAG_SCRIPT_TAG=

# ================= TELEGRAM NOTIFIER CONFIG =================
# Bot token from @BotFather (e.g. 123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ)
BOT_TOKEN=your_telegram_bot_token_here
# Your Telegram numeric user ID to receive reports (e.g. 123456789)
OWNER_ID=your_telegram_owner_id_here
