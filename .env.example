# ================= FIREBASE RTDB CONFIG =================
FIREBASE_DB_URL=https://secret-gpt-default-rtdb.asia-southeast1.firebasedatabase.app

# ================= TELEGRAM CONFIG =================
# Telegram API credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Bot token for notifications from @BotFather
BOT_TOKEN=
# Your numeric Telegram user ID to receive notifications
OWNER_ID=
# Target public Telegram channel (e.g. Nox_oo1)
TELEGRAM_CHANNEL=Nox_oo1

# ================= PINTEREST CONFIG =================
# Pinterest session cookie (_pinterest_sess value)
PINTEREST_SESSION=
# Target Pinterest Board ID
PINTEREST_BOARD_ID=
# Your Pinterest Username
PINTEREST_USERNAME=
# Interval between posting pins in minutes (safe: 35)
POST_INTERVAL_MINUTES=35

# ================= WEB APP & MONETAG CONFIG =================
# Your live Render URL (e.g. https://nox-pfp.onrender.com)
SITE_BASE_URL=
# Fallback landing URL (optional)
FALLBACK_LANDING_URL=
# Countdown timer in seconds before download activates
TIMER_SECONDS=9
# Monetag direct ad link (opened in new tab on download click)
MONETAG_DIRECT_LINK=
# Monetag script tag for In-Page Push / Vignette ads
MONETAG_SCRIPT_TAG=

# ================= BOT 2 (VIRAL 18+ CLICKBAIT & 5-CLICK UNLOCK) =================
# Naye Pinterest account ka session cookie (_pinterest_sess)
VIRAL_PINTEREST_SESSION=
# Naye account ka Pinterest username
VIRAL_PINTEREST_USERNAME=
# Telegram Bot redirect link after 5 clicks unlock
TELEGRAM_REDIRECT_BOT=https://t.me/landytv_bot
# Interval between posting viral pins (in minutes, safe: 35)
VIRAL_POST_INTERVAL_MINUTES=35
# Number of ad clicks required to unlock video (default: 5)
VIRAL_UNLOCK_CLICKS=5
